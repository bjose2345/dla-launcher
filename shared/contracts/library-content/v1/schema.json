{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dla-launcher:library-content-scenarios:v1",
  "title": "DLA Launcher library-content scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "fixtureRoot", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "fixtureRoot": { "$ref": "#/$defs/relativePath" },
        "expected": { "$ref": "#/$defs/detection" }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceScanSessionId",
        "catalogIdentity",
        "suggestedStatus",
        "contentItems",
        "launchCandidates"
      ],
      "properties": {
        "sourceScanSessionId": { "type": "null" },
        "catalogIdentity": { "type": "null" },
        "suggestedStatus": { "enum": ["ready", "needs_review"] },
        "contentItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentItem" }
        },
        "launchCandidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/launchCandidate" }
        }
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "pathKey",
        "mediaType",
        "sizeBytes",
        "modifiedAt",
        "confidence",
        "reasonCodes"
      ],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "pathKey": { "type": "string", "minLength": 1 },
        "mediaType": {
          "enum": [
            "executable",
            "audio",
            "image",
            "pdf",
            "video",
            "archive",
            "android_package",
            "directory",
            "unknown"
          ]
        },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "modifiedAt": { "type": "null" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "launchCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "target",
        "supportedPlatforms",
        "confidence",
        "reasonCodes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": {
          "enum": [
            "launch_executable",
            "play_audio",
            "read_images",
            "open_document",
            "play_video",
            "open_archive",
            "open_android_package"
          ]
        },
        "target": { "$ref": "#/$defs/launchTarget" },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["windows", "linux", "macos", "android", "ios", "unknown"]
          }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "launchTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "installation_root" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "relative_path" },
            "path": { "$ref": "#/$defs/relativePath" }
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    }
  }
}
