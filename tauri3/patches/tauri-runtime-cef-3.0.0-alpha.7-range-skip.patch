+  #[test]
+  fn skip_positions_a_partial_body_by_its_content_range() {
+    let mut response = http::Response::builder()
+      .status(206)
+      .header(CONTENT_RANGE, "bytes 1000-1999/5000")
+      .body(Cursor::new(vec![7; 1000]))
+      .unwrap();
+    assert_eq!(skip_body(&mut response, 1000), Some(1000));
+    assert_eq!(response.body().position(), 0);
+    assert_eq!(body_length(&response), 1000);
+    assert_eq!(skip_body(&mut response, 1300), Some(1300));
+    assert_eq!(response.body().position(), 300);
+    assert_eq!(body_length(&response), 700);
+    assert_eq!(skip_body(&mut response, 999), None);
+    assert_eq!(skip_body(&mut response, 2001), None);
+    assert_eq!(skip_body(&mut response, -1), None);
+  }
+
+  #[test]
+  fn skip_drops_the_head_of_a_whole_resource() {
+    let mut response = http::Response::new(Cursor::new(vec![1; 20]));
+    assert_eq!(skip_body(&mut response, 10), Some(10));
+    assert_eq!(response.body().position(), 10);
+    assert_eq!(body_length(&response), 10);
+    assert_eq!(skip_body(&mut response, 21), None);
+  }
