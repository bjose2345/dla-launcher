+/// Marks the response to a HEAD request: its empty body says nothing about the length.
+#[derive(Clone, Copy)]
+struct HeadResponse;
+
+/// Positions the body at `offset` bytes into the whole resource and returns `offset`, or
+/// `None` when the body does not reach it.
+fn skip_body(response: &mut http::Response<Cursor<Vec<u8>>>, offset: i64) -> Option<i64> {
+  let offset = u64::try_from(offset).ok()?;
+  let first_body_byte = content_range_start(response.headers()).unwrap_or(0);
+  let within_body = offset.checked_sub(first_body_byte)?;
+  let body = response.body_mut();
+  let position = body.position().checked_add(within_body)?;
+  if position > body.get_ref().len() as u64 {
+    return None;
+  }
+  body.set_position(position);
+  i64::try_from(offset).ok()
+}
+
+/// The resource offset a partial body starts at: `Content-Range: bytes <start>-<end>/<total>`.
+fn content_range_start(headers: &HeaderMap) -> Option<u64> {
+  let value = headers.get(CONTENT_RANGE)?.to_str().ok()?;
+  let (start, _) = value
+    .trim()
+    .strip_prefix("bytes")?
+    .trim_start()
+    .split_once('-')?;
+  start.trim().parse().ok()
+}
+
+/// What `read` will deliver: the whole body is in hand before CEF reads it, less what
+/// `skip` dropped. A HEAD response has no body to measure, so its length stays unknown
+/// and the app's `Content-Length` header stands.
+fn body_length(response: &http::Response<Cursor<Vec<u8>>>) -> i64 {
+  if response.extensions().get::<HeadResponse>().is_some() {
+    return -1;
+  }
+  let body = response.body();
+  i64::try_from((body.get_ref().len() as u64).saturating_sub(body.position())).unwrap_or(-1)
+}
