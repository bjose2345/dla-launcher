+    /// CEF answers a `Range` request by opening the resource and skipping to its first
+    /// byte before reading, so a handler that returns the whole resource serves any range.
+    /// The app's protocol handler sees the `Range` header and may answer with the partial
+    /// body itself (`206` with `Content-Range: bytes <start>-<end>/<total>`); that body
+    /// already begins at `<start>`, so only the bytes from there to the requested offset
+    /// are dropped. Without this method CEF's default refuses every range past the first
+    /// byte with `ERR_REQUEST_RANGE_NOT_SATISFIABLE`.
+    fn skip(
+      &self,
+      bytes_to_skip: i64,
+      bytes_skipped: Option<&mut i64>,
+      _callback: Option<&mut ResourceSkipCallback>,
+    ) -> ::std::os::raw::c_int {
+      let Some(bytes_skipped) = bytes_skipped else {
+        return 0;
+      };
+      let skipped = self
+        .response
+        .borrow_mut()
+        .as_mut()
+        .and_then(|response| skip_body(response, bytes_to_skip));
+      match skipped {
+        Some(count) => {
+          *bytes_skipped = count;
+          1
+        }
+        None => {
+          // ERR_FAILED: CEF reports the range as not satisfiable.
+          *bytes_skipped = -2;
+          0
+        }
+      }
+    }
