diff --git a/ffmpeg_generated.gni b/ffmpeg_generated.gni
index 6dd28dae57..8b54244866 100644
--- a/ffmpeg_generated.gni
+++ b/ffmpeg_generated.gni
@@ -597,3 +597,47 @@ if ((is_android && (current_cpu == "arm64" || current_cpu == "arm64e")) ||
     (is_android && current_cpu == "x86")) {
   ffmpeg_c_sources += [ "compat/strtod.c" ]
 }
+
+# The HEVC software decoder and parser (hevc_decoder, hevc_parser and what
+# configure selects for them: bswapdsp, hevcparse, hevc_sei), which Chromium's
+# config leaves out. Kept in step with chromium/config/Chrome/linux/x64.
+if (use_linux_config && current_cpu == "x64" && ffmpeg_branding == "Chrome") {
+  ffmpeg_c_sources += [
+    "libavcodec/bswapdsp.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_cabac.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_parse.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_parser.c",
+    "libavcodec/hevc/data.c",
+    "libavcodec/hevc/dsp.c",
+    "libavcodec/hevc/filter.c",
+    "libavcodec/hevc/hevcdec.c",
+    "libavcodec/hevc/mvs.c",
+    "libavcodec/hevc/pred.c",
+    "libavcodec/hevc/ps.c",
+    "libavcodec/hevc/refs.c",
+    "libavcodec/hevc/sei.c",
+    "libavcodec/x86/bswapdsp_init.c",
+    "libavcodec/x86/h26x/h2656dsp.c",
+    "libavcodec/x86/hevc/dsp_init.c",
+  ]
+  ffmpeg_asm_sources += [
+    "libavcodec/x86/bswapdsp.asm",
+    "libavcodec/x86/h26x/h2656_inter.asm",
+    "libavcodec/x86/hevc/add_res.asm",
+    "libavcodec/x86/hevc/deblock.asm",
+    "libavcodec/x86/hevc/dequant.asm",
+    "libavcodec/x86/hevc/idct.asm",
+    "libavcodec/x86/hevc/mc.asm",
+    "libavcodec/x86/hevc/sao.asm",
+    "libavcodec/x86/hevc/sao_10bit.asm",
+  ]
+  ffmpeg_c_deps += [
+    "libavcodec/hevc/cabac.c",
+    "libavcodec/hevc/parse.c",
+    "libavcodec/hevc/parser.c",
+  ]
+  ffmpeg_asm_deps += [
+    "libavcodec/x86/h26x/h2656_sao.asm",
+    "libavcodec/x86/h26x/h2656_sao_10bit.asm",
+  ]
+}
