diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
index efc7246c8cd3e..8bf82bebd6287 100644
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -228,6 +228,24 @@ bool IsAudioCodecProprietary(AudioCodec codec) {
 }
 #endif  // !BUILDFLAG(USE_PROPRIETARY_CODECS)
 
+// Profiles FFmpeg's HEVC software decoder handles. Chromium's FFmpeg config
+// leaves that decoder out; this build turns it on (third_party/ffmpeg's
+// Chrome/linux/x64 config), so these play without a platform decoder.
+bool IsDecoderBuiltInHevcProfile(VideoCodecProfile profile) {
+  if (!IsDecoderBuiltInVideoCodec(VideoCodec::kHEVC)) {
+    return false;
+  }
+  switch (profile) {
+    case HEVCPROFILE_MAIN:
+    case HEVCPROFILE_MAIN10:
+    case HEVCPROFILE_MAIN_STILL_PICTURE:
+    case HEVCPROFILE_REXT:
+      return true;
+    default:
+      return false;
+  }
+}
+
 bool IsDecoderHevcProfileSupported(const VideoType& type) {
   if (!IsColorSpaceSupported(type.color_space)) {
     return false;
@@ -241,7 +259,8 @@ bool IsDecoderHevcProfileSupported(const VideoType& type) {
   }
 #endif  // BUILDFLAG(IS_CHROMEOS)
   return GetSupplementalDecoderVideoProfileCache()->IsProfileSupported(
-      type.profile);
+             type.profile) ||
+         IsDecoderBuiltInHevcProfile(type.profile);
 #else
   return true;
 #endif  // BUIDFLAG(PLATFORM_HAS_OPTIONAL_HEVC_DECODE_SUPPORT)
@@ -583,6 +602,13 @@ bool IsDecoderBuiltInVideoCodec(VideoCodec codec) {
   if (codec == VideoCodec::kH264) {
     return true;
   }
+#if BUILDFLAG(ENABLE_PLATFORM_HEVC) && BUILDFLAG(IS_LINUX)
+  // FFmpeg is built with hevc_decoder on this platform (third_party/ffmpeg's
+  // Chrome/linux/x64 config).
+  if (codec == VideoCodec::kHEVC) {
+    return true;
+  }
+#endif  // BUILDFLAG(ENABLE_PLATFORM_HEVC) && BUILDFLAG(IS_LINUX)
 #endif  // BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS) &&
         // BUILDFLAG(USE_PROPRIETARY_CODECS)
 #if BUILDFLAG(ENABLE_LIBVPX)
diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
